# Copie para .env e ajuste. Nunca versione o .env.

NODE_ENV=development
# Porta da API. (Não usamos PORT: hospedagens e ferramentas costumam reservá-la para o front-end.)
API_PORT=4000
HOST=127.0.0.1

# Origens autorizadas a chamar a API a partir do navegador (separadas por vírgula).
WEB_ORIGIN=http://localhost:5173

# Chave AES-256-GCM (32 bytes em base64) para cifrar credenciais de marketplace e segredos MFA.
# Obrigatória em produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Dados sintéticos para testes e avaliação. Deixe "false" em uso real: a aplicação trabalha só
# com dados importados (relatórios, planilha do ERP, XML de NF-e) ou vindos das APIs.
GRANDIR_DEMO_MODE=false

# Auditoria automática das lojas conectadas por API: intervalo em horas (0 desliga).
SYNC_INTERVAL_HOURS=24

# Integrações por API (opcionais). Sem estas credenciais, a entrada de dados é por arquivo.
# Mercado Livre: aplicativo criado em developers.mercadolivre.com.br, com a URL de retorno
#   <OAUTH_REDIRECT_BASE>/api/oauth/mercadolivre/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Shopee Open Platform: parceiro aprovado, com a URL de retorno
#   <OAUTH_REDIRECT_BASE>/api/oauth/shopee/callback
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Produção: https://partner.shopeemobile.com (padrão). Testes: https://partner.test-stable.shopeemobile.com
# SHOPEE_API_HOST=https://partner.shopeemobile.com
# TikTok Shop Partner Center: app com a URL de retorno
#   <OAUTH_REDIRECT_BASE>/api/oauth/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# TIKTOK_AUTH_HOST=https://services.tiktokshop.com
# TIKTOK_TOKEN_HOST=https://auth.tiktok-shops.com
# TIKTOK_API_HOST=https://open-api.tiktokglobalshop.com
# Origem pública (HTTPS) que recebe o retorno do OAuth. Padrão: WEB_ORIGIN.
# OAUTH_REDIRECT_BASE=

# Taxa de sucesso padrão para novos clientes, em pontos-base (2000 = 20%).
DEFAULT_FEE_RATE_BPS=2000

# Caminhos de dados (padrão: ./data na raiz do repositório).
# DATABASE_PATH=
# UPLOAD_DIR=
